views:
  - type: table
    name: 表格
    filters:
      and:
        - file.ext == "md"
        - '!file.path.contains("node_modules")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - file.ctime
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 870
  - type: table
    name: 视图
    filters:
      and:
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
