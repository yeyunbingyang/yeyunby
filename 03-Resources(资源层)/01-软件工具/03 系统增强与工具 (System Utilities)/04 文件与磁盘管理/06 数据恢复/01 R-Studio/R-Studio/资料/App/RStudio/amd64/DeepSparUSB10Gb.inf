HKLM,SYSTEM\CurrentControlSet\Control\Class\{4d36e97b-e325-11ce-bfc1-08002be10318},"LowerFilters",0x00010008,DeepSparUSB10Gb	;SCSIAdapter
;HKLM,SYSTEM\CurrentControlSet\Control\Class\{88BAE032-5A81-49f0-BC3D-A4FF138216D6},"UpperFilters",0x00010008,DeepSparUSB10Gb	;USBDevice
HKLM,SYSTEM\CurrentControlSet\Control\Class\{88BAE032-5A81-49f0-BC3D-A4FF138216D6},"LowerFilters",0x00010008,DeepSparUSB10Gb	;USBDevice
HKLM,SYSTEM\CurrentControlSet\Services\DeepSparUSB10Gb, "TurnOffDriveIfInactiveTimeout", 0x00010001, 300 ;in seconds
HKLM,SYSTEM\CurrentControlSet\Services\DeepSparUSB10Gb, "ErrorOutEachSourceReadBlockTimeout", 0x00010001, 30 ;in ms
HKLM,SYSTEM\CurrentControlSet\Services\DeepSparUSB10Gb, "AutoRepowerToApplySettings", 0x00010001, 1
HKLM,SYSTEM\CurrentControlSet\Services\DeepSparUSB10Gb, "UsbfDispatchLevel", 0x00010001, 1
HKLM,SYSTEM\CurrentControlSet\Services\DeepSparUSB10Gb, "DbgSrc", 0x00010001, 0
HKLM,SYSTEM\CurrentControlSet\services\DeepSparUSB10Gb, "DbgTgt", 0 , ""
HKLM,SYSTEM\CurrentControlSet\services\DeepSparUSB10Gb, "DbgUa", 0 , ""
